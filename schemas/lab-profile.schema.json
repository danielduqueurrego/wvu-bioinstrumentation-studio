{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edu.wvu.example/bioinstrumentation/lab-profile.schema.json",
  "title": "WVU Bioinstrumentation Studio Lab Profile",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "display_name",
    "locked",
    "max_recording_seconds",
    "adc_bits"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "locked": {
      "type": "boolean"
    },
    "max_recording_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "adc_bits": {
      "type": "integer",
      "enum": [
        10,
        12,
        14
      ]
    },
    "defaults": {
      "type": "object"
    },
    "safety_notice": {
      "type": "string"
    }
  },
  "additionalProperties": true
}