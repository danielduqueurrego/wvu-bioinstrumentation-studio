    "state_dwell_us": 1000
  },
  "display": { "primary_quantity": "arduino_input_volts", "channel_label": "Raw TX + RX photodetectors by LED state", "raw_units_label": "ADC counts", "voltage_units_label": "V", "voltage_reference_v": 5.0, "plot_min_v": 0.0, "plot_max_v": 5.0 },
