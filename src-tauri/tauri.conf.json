{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WVU Bioinstrumentation Studio",
  "version": "1.0.0",
  "identifier": "edu.wvu.bioinstrumentationstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "WVU Bioinstrumentation Studio",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "category": "Education",
    "resources": [
      "resources/arduino-runtime.zip",
      "resources/arduino-runtime-manifest.json"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
