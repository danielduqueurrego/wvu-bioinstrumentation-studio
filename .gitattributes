# The reference sketch is embedded verbatim by the desktop application and
# verified against its release-manifest SHA-256. Keep its checkout bytes stable
# on Windows as well as Unix hosts.
firmware/reference_unor4wifi/reference_unor4wifi.ino text eol=lf

# Windows scripts are checked out with CRLF on every host. cmd.exe label
# lookups (`goto :finish`) are unreliable in LF-only batch files, and CRLF is
# the native format for Windows PowerShell 5.1. The repository still stores LF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Distribution archives are binary; never convert their line endings.
*.zip binary
